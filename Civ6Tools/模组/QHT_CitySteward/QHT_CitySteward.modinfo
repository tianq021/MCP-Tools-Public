<?xml version="1.0" encoding="utf-8"?>
<Mod id="2a992a74-614c-4f66-9047-832113833d73" version="1">
  <Properties>
    <Name>城市生产托管</Name>
    <Description>单人游戏的生产托管面板。为空队列安排修复、建筑或城市项目。</Description>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <InGameActions>
    <AddUserInterfaces id="QHT_CitySteward_UI">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>120</LoadOrder>
      </Properties>
      <File>UI/CitySteward.xml</File>
    </AddUserInterfaces>
  </InGameActions>
  <Files>
    <File>UI/CitySteward.xml</File>
    <File>UI/CitySteward.lua</File>
  </Files>
</Mod>
