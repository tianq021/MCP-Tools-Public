    <Compile Include="..\..\plugin\SlimeRancher2Bridge\ToolsFabrication.cs" Link="ToolsFabrication.cs" />
    <Compile Include="..\..\plugin\SlimeRancher2Bridge\ToolsExploration.cs" Link="ToolsExploration.cs" />
